{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vani.local/schemas/canonical-work-0.1.json",
  "title": "VANI Canonical Work Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "canonical_title", "manifestations", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "format": "uuid"},
    "canonical_title": {"type": "string", "minLength": 1},
    "normalized_title": {"type": "string"},
    "work_type": {"type": "string"},
    "language": {"type": ["string", "null"]},
    "abstract": {"type": ["string", "null"]},
    "verification_status": {"$ref": "#/$defs/verificationStatus"},
    "identifiers": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifier"}
    },
    "manifestations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/manifestation"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "provenance": {
      "type": "array",
      "items": {"$ref": "#/$defs/provenance"}
    }
  },
  "$defs": {
    "verificationStatus": {
      "enum": [
        "verified_authoritative",
        "verified_multi_source",
        "verified_with_minor_differences",
        "provisional",
        "conflicting_metadata",
        "incomplete",
        "user_corrected",
        "superseded"
      ]
    },
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {"type": "string"},
        "value": {"type": "string"},
        "original_value": {"type": "string"},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "personName": {
      "type": "object",
      "required": ["display", "family"],
      "properties": {
        "display": {"type": "string"},
        "given": {"type": ["string", "null"]},
        "family": {"type": "string"},
        "particles": {"type": ["string", "null"]},
        "suffix": {"type": ["string", "null"]},
        "orcid": {"type": ["string", "null"]},
        "position": {"type": "integer", "minimum": 1},
        "affiliations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dateParts": {
      "type": ["object", "null"],
      "required": ["year"],
      "properties": {
        "year": {"type": "integer", "minimum": 1000, "maximum": 9999},
        "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "day": {"type": "integer", "minimum": 1, "maximum": 31}
      }
    },
    "manifestation": {
      "type": "object",
      "required": ["id", "type", "title", "authors", "verification_status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "type": {
          "enum": [
            "submission", "preprint", "accepted_manuscript",
            "proceedings_version", "journal_version", "version_of_record",
            "revision", "correction", "retraction", "editorial_notice", "supplement"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": ["string", "null"]},
        "authors": {"type": "array", "items": {"$ref": "#/$defs/personName"}},
        "venue": {
          "type": ["object", "null"],
          "properties": {
            "canonical_name": {"type": "string"},
            "abbreviation": {"type": "string"},
            "event_name": {"type": ["string", "null"]}
          }
        },
        "publisher": {"type": ["string", "null"]},
        "volume": {"type": ["string", "null"]},
        "issue": {"type": ["string", "null"]},
        "article_number": {"type": ["string", "null"]},
        "pages": {"type": ["string", "null"]},
        "dates": {
          "type": "object",
          "properties": {
            "submitted": {"$ref": "#/$defs/dateParts"},
            "accepted": {"$ref": "#/$defs/dateParts"},
            "online": {"$ref": "#/$defs/dateParts"},
            "issued": {"$ref": "#/$defs/dateParts"},
            "print": {"$ref": "#/$defs/dateParts"}
          }
        },
        "identifiers": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "citation_key": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"},
        "verification_status": {"$ref": "#/$defs/verificationStatus"}
      }
    },
    "relation": {
      "type": "object",
      "required": ["predicate", "target_id", "verification_status"],
      "properties": {
        "predicate": {"type": "string"},
        "target_id": {"type": "string"},
        "verification_status": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "retrieved_at"],
      "properties": {
        "source": {"type": "string"},
        "external_id": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "payload_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "license": {"type": ["string", "null"]}
      }
    }
  }
}

