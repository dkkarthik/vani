NODE_ENV=development
VANI_API_HOST=127.0.0.1
VANI_API_PORT=8080
VANI_WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://vani:vani@127.0.0.1:5432/vani
VANI_DATA_DIR=./data
VANI_DEMO_MODE=false
OPENALEX_API_KEY=
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b-q4_K_M

OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
VANI_EMBED_MODEL=qwen3-embedding:0.6b
# Optional alternate local reasoning model for quiet-window audits.
# OLLAMA_AUDIT_MODEL=qwen3.8:27b-q4_K_M
VANI_CLOUD_MODE=off
VANI_CLOUD_DAILY_TOKENS=0
VANI_CLOUD_MONTHLY_TOKENS=0

# Optional local generation limits in milliseconds (maximum 600000).
# VANI_D1_TIMEOUT_MS=180000
# VANI_D2_TIMEOUT_MS=360000
# VANI_D3_TIMEOUT_MS=600000

# Production web UI: LAN access; set 127.0.0.1 for local-only access.
VANI_WEB_HOST=0.0.0.0
