{
  "manifest_version": 3,
  "name": "VANI — Save academic papers",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Save academic papers, metadata, source links, and available PDFs into your local VANI research collections.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Save to VANI" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
